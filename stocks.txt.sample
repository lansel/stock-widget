# 股票代码：一行一个代码，可跟别名（自定义显示名），# 后为注释
600519 茅台
000001
1A0001

# 常见指数：1A0001=上证指数 399001=深证成指 399006=创业板指
# 000016=上证50 000300=沪深300 000905=中证500 000688=科创50 000852=中证1000
# 也支持带前缀写法：sh000300 sz399001

# 配置项
# hideOnWinD=true 时按 Win+D 隐藏挂件，打开任意软件自动恢复（默认 false）
hideOnWinD=false

# 开机自启（默认 true）；false = 不写自启项并移除已有的（热生效）
autostart=true

# 现价列（默认 false；true = 名称和涨跌幅之间显示现价）
showPrice=false

# 透明度 0.1~1.0（默认 0.92）
opacity=0.92

# 背景色 十六进制 RGB（默认 #202024）
bgColor=#202024

# 股票名称文字色（默认 #F5F5F5）
nameColor=#F5F5F5
